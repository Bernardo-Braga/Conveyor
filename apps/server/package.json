{
  "name": "@conveyor/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@conveyor/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@napi-rs/keyring": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "vitest": "^5.0.1"
  }
}
