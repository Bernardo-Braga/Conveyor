{
  "name": "conveyor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local control panel: supplier link to Shopify draft, AI creatives and a paused Meta campaign.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @conveyor/server --filter @conveyor/web dev",
    "start": "pnpm --filter @conveyor/web build && CONVEYOR_ENV=production pnpm --filter @conveyor/server start",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --sequential typecheck",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @conveyor/server db:generate",
    "codex:smoke": "tsx scripts/codex-smoke.ts",
    "capture:fixtures": "tsx scripts/capture-rapidapi-fixtures.ts",
    "writer:smoke": "tsx scripts/listing-writer-smoke.ts",
    "meta:test-launch": "tsx scripts/meta-test-launch.ts",
    "start-at-login": "tsx scripts/start-at-login.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
